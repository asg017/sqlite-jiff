Source: ../snapshot.sql
with test_cases(time, mode, smallest, increment) as (
  values
    ('12:59:00', 'floor', 'hour', 1),
    ('12:01:00', 'ceil', 'minute', 20)
)
select 
  test_cases.*,
  jiff_time_round(
    time,
    'mode', mode,
    'smallest', smallest,
    'increment', increment
) as result
from test_cases;
---
{
	 time: '12:59:00'
	 mode: 'floor'
	 smallest: 'hour'
	 increment: 1
	 result: '12:00:00'
}
{
	 time: '12:01:00'
	 mode: 'ceil'
	 smallest: 'minute'
	 increment: 20
	 result: '12:20:00'
}

