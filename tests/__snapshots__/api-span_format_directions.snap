Source: ../api.sql
with testcases(value) as (values ('1 hour 42 minutes'), ('1 hour 42 minutes ago'))
select value, direction, jiff_span_format(value, 'direction', direction) as result
from testcases, directions;
---
{
	 value: '1 hour 42 minutes'
	 direction: 'auto'
	 result: '1h 42m'
}
{
	 value: '1 hour 42 minutes'
	 direction: 'sign'
	 result: '1h 42m'
}
{
	 value: '1 hour 42 minutes'
	 direction: 'force-sign'
	 result: '+1h 42m'
}
{
	 value: '1 hour 42 minutes'
	 direction: 'suffix'
	 result: '1h 42m'
}
{
	 value: '1 hour 42 minutes ago'
	 direction: 'auto'
	 result: '1h 42m ago'
}
{
	 value: '1 hour 42 minutes ago'
	 direction: 'sign'
	 result: '-1h 42m'
}
{
	 value: '1 hour 42 minutes ago'
	 direction: 'force-sign'
	 result: '-1h 42m'
}
{
	 value: '1 hour 42 minutes ago'
	 direction: 'suffix'
	 result: '1h 42m ago'
}

