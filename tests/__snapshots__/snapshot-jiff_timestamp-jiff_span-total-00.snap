Source: ../snapshot.sql
with testcases(span) as (
  values
  ('2 minutes'),
  ('1 nanosecond')
)
select 
  span,
  unit,
  jiff_span_total(span, unit)
from testcases
join units
where unit not in ('year', 'week', 'month')
order by span, units.rowid;
